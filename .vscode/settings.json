{
	"hide-files.files": [
		".next",
		"pnpm-lock.yaml",
		"node_modules",
		"pnpm-workspace.yaml",
		".vscode",
		"eslint.config.mjs",
		"components.json",
		"postcss.config.mjs",
		"next.config.ts",
